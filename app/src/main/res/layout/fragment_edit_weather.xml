<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/weather_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="18dp"
            android:gravity="center"
            android:text="@string/edit_title"
            android:textColor="@color/weather_primary_dark"
            android:textSize="20sp"
            android:textStyle="bold" />

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="@string/label_date"
            android:textColor="@color/weather_text_sec"
            android:textSize="13sp" />

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/etEditDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/input_weather_bg"
            android:padding="12dp"
            android:textColor="@color/weather_text_main"
            android:textSize="15sp" />

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="4dp"
            android:text="@string/label_time_of_day"
            android:textColor="@color/weather_text_sec"
            android:textSize="13sp" />

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/etEditTimeOfDay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/input_weather_bg"
            android:padding="12dp"
            android:textColor="@color/weather_text_main"
            android:textSize="15sp" />

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="4dp"
            android:text="@string/label_temp"
            android:textColor="@color/weather_text_sec"
            android:textSize="13sp" />

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/etEditTemp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/input_weather_bg"
            android:padding="12dp"
            android:textColor="@color/weather_primary_dark"
            android:textSize="15sp"
            android:textStyle="bold" />

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="4dp"
            android:text="@string/label_city"
            android:textColor="@color/weather_text_sec"
            android:textSize="13sp" />

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/etEditCity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/input_weather_bg"
            android:padding="12dp"
            android:textColor="@color/weather_text_main"
            android:textSize="15sp" />

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="4dp"
            android:text="@string/label_condition"
            android:textColor="@color/weather_text_sec"
            android:textSize="13sp" />

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/etEditCondition"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/input_weather_bg"
            android:padding="12dp"
            android:textColor="@color/weather_text_main"
            android:textSize="15sp" />

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="4dp"
            android:text="@string/label_comment"
            android:textColor="@color/weather_text_sec"
            android:textSize="13sp" />

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/etEditComment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/input_weather_bg"
            android:minLines="2"
            android:padding="12dp"
            android:textColor="@color/weather_text_main"
            android:textSize="14sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/btn_weather_primary"
            android:text="@string/btn_save"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnBack"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/btn_weather_secondary"
            android:text="@string/btn_back"
            android:textColor="@color/weather_primary"
            android:textSize="15sp" />

    </LinearLayout>

</ScrollView>
